{
  "domain": "recuair",
  "name": "Recuair",
  "documentation": "https://github.com/tprochazka/recuair-home-assistant-integration",
  "issue_tracker": "https://github.com/tprochazka/recuair-home-assistant-integration/issues",
  "codeowners": [
    "@tprochazka"
  ],
  "config_flow": true,
  "iot_class": "local_polling",
  "version": "0.2.1",
  "requirements": [
    "beautifulsoup4==4.12.3"
  ],
  "dependencies": [
    "dhcp",
    "zeroconf"
  ],
  "dhcp": [
    {
      "hostname": "dc40*"
    },
    {
      "registered_devices": true
    }
  ],
  "zeroconf": [
    {
      "type": "_http._tcp.local.",
      "name": "dc40*"
    }
  ],
  "after_dependencies": [
    "frontend"
  ]
}
